{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voxel-meadow",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "host": "localhost"
  },
  "routes": [
    {
      "pattern": "geminisland.raph.plus",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/og-vertical.jpg", "/og-square.jpg", "/og-image.jpg", "/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORLD_DO",
        "class_name": "WorldDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorldDO"]
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "vars": {
    "HYDROGEN_MODEL": "hydrogen-l",
    "HYDROGEN_MODELS": "hydrogen-l,hydrogen-l-high-0p70,hydrogen-l-high-1p00,hydrogen-l-high-0p50,hydrogen-l-high-0p30,hydrogen-l-high-0p10,hydrogen-g,hydrogen-f,hydrogen-j",
    "ARGON_MODEL": "gemini-4-argon",
    "BARIUM_MODELS": "barium-b,barium-c,barium-bb-v2,barium-bb3,barium-bb2,barium-bb,barium-a,barium-cc3",
    "FALLBACK_MODEL": "gemini-3.8-flash",
    "MINIGAME_MODEL": "gemini-3.1-flash-lite"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
